#!/bin/sh
# Push the configs on disk into whatever is already running. Long-lived
# processes read theirs once at startup, so e.g. a tmux server kept alive
# by resurrect/continuum can sit on a weeks-old tmux.conf. Anything that
# isn't running is skipped.
#
#   dots-reload                  everything
#   dots-reload TARGET...        tmux kitty quickshell sway
#
# The one reload path for install.sh and the launcher's "reload". tmux is
# reloaded here; the desktop targets go on to rice-reload (~/.rice,
# desktop profile), and are skipped on a terminal-only machine that
# doesn't have it. DOTS_NO_RELOAD=1 makes it a no-op.
[ -n "${DOTS_NO_RELOAD:-}" ] && exit 0
[ $# -gt 0 ] || set -- tmux kitty quickshell sway

tmux=; desktop=
for target; do
    case $target in
        tmux) tmux=1 ;;
        kitty|quickshell|sway) desktop="$desktop $target" ;;
        *) sed -n '7,8p' "$0" | sed 's/^# \{0,1\}/usage: /' >&2; exit 1 ;;
    esac
done

if [ -n "$tmux" ] && tmux list-sessions >/dev/null 2>&1; then
    echo "==> reloading tmux"
    tmux source-file "$HOME/.config/tmux/tmux.conf" || echo "warning: tmux reload failed" >&2
fi

rice_reload="${DOTS_RICE_RELOAD:-$HOME/.local/bin/rice-reload}"
if [ -n "$desktop" ] && [ -x "$rice_reload" ]; then
    # shellcheck disable=SC2086  # one word per target
    exec "$rice_reload" $desktop
fi
exit 0
